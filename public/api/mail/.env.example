# Copiar a .env (misma carpeta) y completar con valores reales.
# .env está gitignored — nunca commitear credenciales reales.
#
# Mismas variables que nora-landing/mail/.env.example a propósito (el
# usuario pidió "mismos mecanismos... y configuraciones").

# mail | smtp — "mail" usa el mail() nativo de PHP vía el MTA local del
# hosting (ej. Exim en cPanel) y no necesita credenciales. "smtp" solo hace
# falta si hay que relayar por un proveedor SMTP externo (ej. Gmail con
# contraseña de aplicación).
MAIL_TRANSPORT=mail

# Solo se usan si MAIL_TRANSPORT=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password

# Identidad "De" que llevan los dos mails (notificación a Nora + confirmación
# a quien escribió). Con MAIL_TRANSPORT=mail, usar un dominio propio ayuda a
# que no caiga en spam (SPF/DKIM del hosting).
MAIL_FROM_ADDRESS=no-reply@norafilmus.com
MAIL_FROM_NAME="Nora Filmus"

# A dónde llega "alguien escribió por el formulario de contacto".
ADMIN_EMAIL=norafilmus@gmail.com
